# data — the big raw CSV and the built DB are never committed
data/*.csv
data/*.csv.gz
data/*.duckdb
data/*.duckdb.wal

# build outputs
exports/*.parquet
reports/figures/*.png
reports/powerbi_dashboard.pdf
artifacts/*
!artifacts/.gitkeep

# EXCEPTIONS: small artefacts the hosted dashboard needs are committed on purpose
# (all derived from the public Lending Club data; no secrets, no full dataset).
!exports/simulator_base_sample.parquet
!artifacts/metrics.json
!artifacts/lgd.json
!artifacts/backtest.json
!artifacts/fairness.json
# model.joblib stays ignored — the hosted dashboard reads the sample parquet, not the model.

# demo/synthetic data generator output (keep the script, not its output)
data/synthetic_accepted.csv

# python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# power bi
*.pbix

